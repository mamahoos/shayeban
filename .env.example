# .env.example — committed template; copy to .env and fill in real values.
# .env is git-ignored from day one (deployment.md §5).
# CI notification values (TELEGRAM_TO / TELEGRAM_TOKEN) are GitHub secrets,
# never app .env keys. LAYA_* keys are deferred until a laya-service exists.

# Telegram bot token
BOT_TOKEN=

# Postgres DSN — compose sets the default; override only for exotic setups
DATABASE_URL=

# Search provider credentials
SEARCH_API_KEY=
SEARCH_API_BASE=
